#!/bin/bash
# Shared stdio launcher for the Odytor MCP server (one installation, used by every agent profile).
# - GitHub credentials come from the GitHub CLI at launch time; nothing is stored or printed.
# - The repository allowlist is fixed here: Odytor treats an empty allowlist as unrestricted, so it is never left to chance.
# - stdout stays clean for the MCP protocol; diagnostics go to stderr. exec keeps signals and exit status intact.
#
# Install by copying to ~/.local/bin/odytor-mcp (see docs/migration-from-git-plus.md). The checkout lives at
# ~/Projects/Anvilary-Tools/odytor; set ODYTOR_HOME to use another location.
set -euo pipefail
export PATH="$PATH:/usr/local/bin:/usr/bin:/bin"   # agent hosts may start us with a sparse PATH

REAL_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"   # agent profiles run with their own HOME
CHECKOUT="${ODYTOR_HOME:-$REAL_HOME/Projects/Anvilary-Tools/odytor}"
ALLOWED_REPOSITORIES="odysseus-dev/odysseus,Anvilary/git-plus"

fail() { echo "odytor-mcp: $*" >&2; exit 1; }

# The canonical command; an installation that has not been reinstalled yet still provides the old name.
EXE="$CHECKOUT/.venv/bin/odytor"
[ -x "$EXE" ] || EXE="$CHECKOUT/.venv/bin/git-plus"
[ -x "$EXE" ] || fail "Odytor executable not found in $CHECKOUT/.venv/bin"
GH="$(command -v gh || true)"; [ -n "$GH" ] || fail "GitHub CLI (gh) not found"

# Non-interactive, profile-independent GitHub CLI authentication.
export GH_CONFIG_DIR="$REAL_HOME/.config/gh" GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1
# Some agent profiles run on a private D-Bus with their own empty keyring, where gh would block. Read the token
# from the user's real session keyring for this one call, and never wait on a prompt.
USER_BUS="/run/user/$(id -u)/bus"
if [ -S "$USER_BUS" ]; then export DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_BUS"; fi
unset GNOME_KEYRING_CONTROL
TOKEN="$(timeout 15 "$GH" auth token --hostname github.com </dev/null 2>/dev/null)" || fail "GitHub CLI is not authenticated or its keyring is unavailable (run: gh auth login)"
[ -n "$TOKEN" ] || fail "GitHub CLI returned no token"

# Local stdio mode uses exactly this credential: drop anything that could select another auth path, under either
# spelling of the setting (a stray old-prefix value next to the new one would otherwise be refused as ambiguous).
unset GH_TOKEN
for suffix in AUTH_TOKEN SERVER_PAT SERVER_PAT_LOGIN SERVER_PAT_REPOSITORY ODYSSEUS_PAT ODYSSEUS_PAT_LOGIN GITHUB_CLIENT_ID \
              GITHUB_CLIENT_SECRET OAUTH_SIGNING_KEY PUBLIC_URL ALLOWED_GITHUB_USERS ALLOWED_REPOSITORIES; do
  unset "ODYTOR_$suffix" "GIT_PLUS_$suffix"
done
export GITHUB_TOKEN="$TOKEN"
unset TOKEN
# Both spellings, with the same value: the launcher may end up running an installation that was made before the rename and
# only reads the old one, and an empty allowlist means unrestricted access. Equal values are accepted by Odytor.
export ODYTOR_ALLOWED_REPOSITORIES="$ALLOWED_REPOSITORIES" GIT_PLUS_ALLOWED_REPOSITORIES="$ALLOWED_REPOSITORIES"

exec "$EXE" --transport stdio "$@"
