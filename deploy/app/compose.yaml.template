name: git-plus   # legacy Compose project name: renaming it would create new, empty volumes and networks

services:
  git-plus:
    image: odytor:@COMMIT@
    container_name: git-plus            # legacy name: the Nginx upstream and the tunnel address the app by it
    restart: unless-stopped
    user: "10001:10001"
    group_add: ["1000"]            # read access to the 0640 runner key owned by the host account
    env_file:
      - .env
    environment:
      ODYTOR_TEST_RUNNER_COMMAND: >-
        ["ssh","-F","/dev/null","-T","-i","/etc/odytor/runner/runner_key","-o","IdentitiesOnly=yes","-o","BatchMode=yes",
        "-o","StrictHostKeyChecking=yes","-o","UserKnownHostsFile=/etc/odytor/runner/known_hosts","-o","ConnectTimeout=10",
        "-o","ServerAliveInterval=15","-o","ServerAliveCountMax=3","-o","ClearAllForwardings=yes","-o","ForwardAgent=no",
        "-p","2222","gp-runner@git-plus-runner-vm"]
      ODYTOR_TEST_POLICIES: /etc/odytor/policies/policy.toml
      ODYTOR_TEST_DATA_DIR: /home/git-plus/test-data
    networks:
      - edge
      - runner
    volumes:
      - git_plus_data:/home/git-plus/data
      - git_plus_test_data:/home/git-plus/test-data
      - ./runner-ssh:/etc/odytor/runner:ro
      - ./policies:/etc/odytor/policies:ro
    tmpfs:
      - /tmp:rw,nosuid,nodev,size=512m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-H", "Host: odytor.example.com", "http://127.0.0.1:8000/.well-known/oauth-authorization-server"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  git-plus-tunnel:
    image: cloudflare/cloudflared:latest
    container_name: git-plus-tunnel
    user: "0:0"
    restart: unless-stopped
    command: tunnel --config /etc/cloudflared/config.yml run
    volumes:
      - ./tunnel:/etc/cloudflared:ro
    networks:
      - edge

volumes:
  git_plus_data:
    name: git_plus_data
  git_plus_test_data:
    name: git_plus_test_data

networks:
  edge:
    external: true
  runner:
    external: true
    name: gp-runner-net
