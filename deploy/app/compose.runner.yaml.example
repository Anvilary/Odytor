# Changes to ~/services/git-plus/compose.yaml for the isolated runner (everything else stays as deployed).
# The existing .env (OAuth, allowlists, PAT) is untouched; runner settings live here, not in .env.
services:
  git-plus:
    image: git-plus:<commit>                      # immutable commit tag
    group_add: ["1000"]                           # lets the container user read the 0640 key owned by the host account
    networks: [edge, runner]
    environment:
      GIT_PLUS_TEST_RUNNER_COMMAND: >-
        ["ssh","-F","/dev/null","-T","-i","/etc/git-plus/runner/runner_key","-o","IdentitiesOnly=yes","-o","BatchMode=yes",
        "-o","StrictHostKeyChecking=yes","-o","UserKnownHostsFile=/etc/git-plus/runner/known_hosts","-o","ConnectTimeout=10",
        "-o","ServerAliveInterval=15","-o","ServerAliveCountMax=3","-o","ClearAllForwardings=yes","-o","ForwardAgent=no",
        "-p","2222","gp-runner@git-plus-runner-vm"]
      GIT_PLUS_TEST_POLICIES: /etc/git-plus/policies/policy.toml
      GIT_PLUS_TEST_DATA_DIR: /home/git-plus/test-data
    volumes:
      - git_plus_data:/home/git-plus/data         # OAuth state: unchanged
      - git_plus_test_data:/home/git-plus/test-data
      - ./runner-ssh:/etc/git-plus/runner:ro      # runner_key (0640) and known_hosts only; never the admin or host keys
      - ./policies:/etc/git-plus/policies:ro
volumes:
  git_plus_test_data:
    name: git_plus_test_data
networks:
  runner:
    external: true
    name: gp-runner-net
