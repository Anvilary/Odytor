# /etc/git-plus-runner/runner.env  (root:root, mode 0644; read by git-plus-runner, never by a shell)
# Pin the image by digest. Load it first: podman pull docker.io/library/python@sha256:...
GIT_PLUS_RUNNER_IMAGE=docker.io/library/python@sha256:REPLACE_WITH_DIGEST
# GIT_PLUS_RUNNER_CPUS=2
# GIT_PLUS_RUNNER_MEMORY_MIB=4096
# GIT_PLUS_RUNNER_PIDS=512
# GIT_PLUS_RUNNER_ENV_TTL_DAYS=7
# GIT_PLUS_RUNNER_ENV_BUDGET_MIB=10240
# GIT_PLUS_RUNNER_MIN_FREE_MIB=2048
# GIT_PLUS_RUNNER_PIP_INDEX_URL=https://pypi.org/simple
